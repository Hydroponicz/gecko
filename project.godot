; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gecko"
run/main_scene="res://scenes/levels/test_level.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

InputSetup="*res://src/Core/InputSetup.cs"
Clock="*res://src/Core/ClockNode.cs"
Gamepad="*res://src/Core/Gamepad.cs"
GameHud="*res://src/UI/GameHud.cs"
DebugMenu="*res://src/UI/DebugMenu.cs"

[dotnet]

project/assembly_name="Gecko"
